{
  "name": "modkit-desktop",
  "productName": "MultiHub",
  "version": "0.2.28",
  "private": true,
  "description": "Менеджер модов для Minecraft Java Edition",
  "author": "MultiHub",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "build:explorer": "node scripts/build-explorer.mjs",
    "dist": "npm run build && npm run build:explorer && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "45.4.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.552.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.0",
    "yauzl": "^3.2.0"
  },
  "build": {
    "appId": "app.modkit.desktop",
    "executableName": "ModKit",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "publish": { "provider": "github", "owner": "blksmamba", "repo": "MultiHub" },
    "extraFiles": [
      {
        "from": "dist-native",
        "filter": [
          "MultiHubExplorer.exe",
          "MultiHub.Explorer.msix"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "installerLanguages": [
        "ru_RU"
      ],
      "artifactName": "MultiHub-Setup-${version}-${arch}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
